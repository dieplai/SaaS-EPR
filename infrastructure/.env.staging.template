# ============================================
# EPR Legal SaaS - STAGING ENVIRONMENT
# ============================================
# This is a TEMPLATE file. Actual secrets are injected by CI/CD.
# DO NOT put real secrets here - use GitHub Secrets instead.
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=staging
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# DATABASES - PostgreSQL
# ============================================
POSTGRES_USER=epr_staging
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=epr_saas_staging
POSTGRES_PORT=5432
DATABASE_URL=postgresql://epr_staging:${POSTGRES_PASSWORD}@postgres:5432/epr_saas_staging?sslmode=disable

# ============================================
# CACHE - Redis
# ============================================
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_MAX_MEMORY=512mb
REDIS_EVICTION_POLICY=allkeys-lru
# Note: Using Redis DB 0 for staging (isolated from production DB 1)

# ============================================
# VECTOR DATABASE - Qdrant (for AI Chatbot)
# ============================================
USE_QDRANT_CLOUD=true
QDRANT_CLOUD_URL=${QDRANT_CLOUD_URL}
QDRANT_API_KEY=${QDRANT_API_KEY}

# ============================================
# SERVICES PORTS
# ============================================
EPR_BACKEND_PORT=8001
AI_CHATBOT_PORT=8000
STREAMLIT_PORT=8501
PORT=8001

# ============================================
# SERVICE URLS (Internal Docker Network)
# ============================================
EPR_BACKEND_URL=http://epr-backend:8001

# ============================================
# SECURITY - JWT
# ============================================
JWT_SECRET=${JWT_SECRET}
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_HOURS=168

