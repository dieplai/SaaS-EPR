# ============================================
# EPR Legal SaaS - PRODUCTION ENVIRONMENT
# ============================================
# This is a TEMPLATE file. Actual secrets are injected by CI/CD.
# DO NOT put real secrets here - use GitHub Secrets instead.
# SECURITY WARNING: This is production - use strong secrets!
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARN

# ============================================
# DATABASES - PostgreSQL
# ============================================
POSTGRES_USER=epr_prod
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=epr_saas_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://epr_prod:${POSTGRES_PASSWORD}@postgres:5432/epr_saas_production?sslmode=require

# ============================================
# CACHE - Redis
# ============================================
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_MAX_MEMORY=1024mb
REDIS_EVICTION_POLICY=allkeys-lru

# ============================================
# VECTOR DATABASE - Qdrant (for AI Chatbot)
# ============================================
USE_QDRANT_CLOUD=true
QDRANT_CLOUD_URL=${QDRANT_CLOUD_URL}
QDRANT_API_KEY=${QDRANT_API_KEY}

# ============================================
# SERVICES PORTS
# ============================================
EPR_BACKEND_PORT=8001
AI_CHATBOT_PORT=8000
PORT=8001

# ============================================
# SERVICE URLS (Internal Docker Network)
# ============================================
EPR_BACKEND_URL=http://epr-backend:8001

# ============================================
# SECURITY - JWT
# ============================================
JWT_SECRET=${JWT_SECRET}
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_HOURS=168

# ============================================
# AI / LLM (for AI Chatbot Service)
# ============================================
OPENAI_API_KEY=${OPENAI_API_KEY}
USE_ADVANCED_RAG=true
CHECK_QUOTA=true
RECORD_USAGE=true

# Optional: LangChain tracing
LANGCHAIN_TRACING_V2=${LANGCHAIN_TRACING_V2:-false}
LANGCHAIN_API_KEY=${LANGCHAIN_API_KEY:-}

# Optional: Web search
TAVILY_API_KEY=${TAVILY_API_KEY:-}
