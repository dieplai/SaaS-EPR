# ============================================
# EPR Legal SaaS - Environment Variables
# ============================================
# This is a REFERENCE file. Copy to .env and fill in your values.
# For production/staging, use infrastructure/.env.*.template files.
# ============================================

NODE_ENV=development
ENVIRONMENT=development
DEBUG=true

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=epr_saas
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=your_jwt_secret_min_32_characters
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_HOURS=168

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# SePay Payment Gateway
# Get these from https://my.sepay.vn
SEPAY_MERCHANT_ID=SP-LIVE-DLAA8B94
SEPAY_SECRET_KEY=spsk_live_75mKd4aF5VFFV9RCs92KhQso6SVuGBa1
# Bank code: BIDV, VCB, TCB, MB, VTB, ACB, etc.
SEPAY_BANK_NAME=BIDV
# Your bank account number (for QR code generation)
SEPAY_BANK_ACCOUNT=96247LAI712004
# Account holder name (as shown in bank account)
SEPAY_ACCOUNT_HOLDER=DIEP DUC LAI

# AI Services
OPENAI_API_KEY=sk-your-openai-key
QDRANT_API_KEY=your_qdrant_key
QDRANT_CLOUD_URL=https://your-qdrant-instance.cloud.qdrant.io:6333
USE_QDRANT_CLOUD=true

# Optional
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
TAVILY_API_KEY=

# Frontend (Vite) - Build time variables
VITE_API_BASE_URL=http://localhost:8001
VITE_CHATBOT_API_URL=http://localhost:8000
