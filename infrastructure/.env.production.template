# ============================================
# EPR Legal SaaS - PRODUCTION ENVIRONMENT
# ============================================
# This is a TEMPLATE file. Actual secrets are injected by CI/CD.
# DO NOT put real secrets here - use GitHub Secrets instead.
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARN

# ============================================
# DATABASES - PostgreSQL
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=epr_saas_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://epr_production:${POSTGRES_PASSWORD}@postgres:5432/epr_saas_production?sslmode=disable

# ============================================
# CACHE - Redis
# ============================================
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_MAX_MEMORY=1gb
REDIS_EVICTION_POLICY=allkeys-lru

# ============================================
# VECTOR DATABASE - Qdrant (for AI Chatbot)
# ============================================
USE_QDRANT_CLOUD=true
QDRANT_CLOUD_URL=${QDRANT_CLOUD_URL}
QDRANT_API_KEY=${QDRANT_API_KEY}

# ============================================
# SERVICES PORTS (Different from staging)
# ============================================
EPR_BACKEND_PORT=8101
AI_CHATBOT_PORT=8100
STREAMLIT_PORT=8601
PORT=8101

# ============================================
# SERVICE URLS (Internal Docker Network)
# ============================================
EPR_BACKEND_URL=http://epr-backend:8101

# ============================================
# SECURITY - JWT
# ============================================
JWT_SECRET=${JWT_SECRET}
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_HOURS=168

